<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 🌑 FULL SCREEN DIM BACKDROP -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <!-- 🎯 CENTER WRAPPER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- 🧸 POPUP CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPopup"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#F8BBD0">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 🐻 Mascot -->
                <ImageView
                    android:id="@+id/bgMascot"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:alpha="0.25"
                    android:src="@drawable/ic_mascot"
                    android:contentDescription="@string/mascot"/>


                <!-- 📦 Content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/did_you_know"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#4A148C"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="12dp"
                        />

                    <!-- Fact -->
                    <TextView
                        android:id="@+id/tvFact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sample_fact"
                        android:textSize="17sp"
                        android:textColor="#333333"
                        android:lineSpacingExtra="8dp"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="sans-serif-medium"/>

                    <!-- Button -->
                    <Button
                        android:id="@+id/btnClose"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="120dp"
                        android:minHeight="48dp"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:layout_gravity="center"
                        android:text="@string/ok"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button_rounded"/>

                </LinearLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</FrameLayout>